---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import weddingsImage from '../../assets/images/the-upbeats-duo-wedding-band.jpeg';
import corporateHireImage from '../../assets/images/The-Upbeats-Party-Band-Corporate-Hire.jpeg';
import cruisesImage from '../../assets/images/the-upbeats-duo-cruise-band.jpeg';
import partiesImage from '../../assets/images/the-upbeats-party-image.jpg';
import christmasImage from '../../assets/images/the-upbeats-party-promo-christmas-party.jpeg';

// Same photo each page already uses as its own hero image (see
// src/pages/products/*.astro) — these used to be separate thumbnails
// hotlinked from the old site's Contentful CMS, which this project has no
// account/control over. Reusing the local photo keeps each page visually
// consistent with its own card here, and removes that dependency entirely.
const services = [
  { href: '/products/weddings', title: 'Weddings', blurb: 'The Upbeats duo are sure to help you get hitched without a hitch! From your ceremony through to the last dance.', image: weddingsImage },
  { href: '/products/corporate-hire', title: 'Corporate Hire', blurb: 'The Upbeats are a sure fire hit for any corporate party, awards do, or client event.', image: corporateHireImage },
  { href: '/products/cruises', title: 'Cruises', blurb: 'The Upbeats Duo have years of experience working onboard cruise ships around the world.', image: cruisesImage },
  { href: '/products/parties', title: 'Parties', blurb: 'The Upbeats duo are sure to get your next birthday, anniversary or private party rocking!', image: partiesImage },
  { href: '/products/christmas-party-band', title: 'Christmas Party Band', blurb: 'Get your office or family Christmas party swinging with a festive set from The Upbeats.', image: christmasImage },
];
---

<Layout
  title="Bookings | The Upbeats Music Duo"
  description="Book The Upbeats Duo for your wedding, corporate event, cruise, party or Christmas do."
  image="/open-graph/bookings.png"
>
  <section class="page-hero">
    <div class="wrap">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Bookings', href: '/products/' }]} />
      <p class="eyebrow">Book us for</p>
      <h1>Every kind of party, covered.</h1>
      <p class="page-hero__sub">Pick the event type below to see pricing information, set details and everything you need to know before booking.</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap grid grid-3">
      {services.map((s) => <ServiceCard {...s} />)}
    </div>
  </section>

  <section class="cta section-tight">
    <div class="wrap cta__inner">
      <div>
        <h2>Not sure which fits?</h2>
        <p>Tell us about your event and we'll point you in the right direction.</p>
      </div>
      <a class="btn btn-solid" href="/contact/">Get in touch</a>
    </div>
  </section>
</Layout>

<style>
  .page-hero { padding-top: 4rem; padding-bottom: 2rem; }
  .page-hero__sub { color: var(--lavender); max-width: 50ch; font-size: 1.1rem; }
  .cta__inner { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1.5rem; background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 2.5rem; }
</style>
