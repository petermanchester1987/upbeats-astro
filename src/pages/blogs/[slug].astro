---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, image, imageAlt, imagePosition } = post.data;

// Falls back to the auto-generated branded OG card (see
// src/pages/open-graph/[...route].ts) for social sharing when the post
// doesn't set its own `image`. The on-page header banner below only shows
// for posts that DO set a real photo — the generated card is a text-only
// social-share graphic, not something you'd want as a full-width page banner.
// `image` is now an optimized-image object (see content.config.ts), not a
// plain URL string, so social sharing needs its own resized, jpg-format
// render — getImage() is the non-component way to get that, since Layout's
// `image` prop just wants a plain URL.
const shareImage = image
  ? (await getImage({ src: image, width: 1200, format: 'jpg' })).src
  : `/open-graph/blog/${post.id}.png`;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(shareImage, Astro.site).toString(),
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: 'The Upbeats Duo' },
  publisher: { '@type': 'Organization', name: 'The Upbeats Duo' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Layout
  title={`${title} | The Upbeats Duo Blog`}
  description={description}
  image={shareImage}
  type="article"
  publishedTime={date}
  structuredData={blogPostingSchema}
>
  <article class="post">
    {image && (
      <div class="post__hero">
        <Image src={image} alt={imageAlt ?? ''} loading="eager" width={1200} style={`object-position: ${imagePosition ?? 'center'};`} />
        <div class="post__hero-scrim"></div>
      </div>
    )}

    <div class="wrap post__inner section-tight">
      <Breadcrumbs items={[
        { name: 'Home', href: '/' },
        { name: 'Blog', href: '/blogs/' },
        { name: title, href: `/blogs/${post.id}` },
      ]} />
      <p class="post__date">
        {date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}
      </p>
      <h1>{title}</h1>
      <div class="post__content">
        <Content />
      </div>
    </div>
  </article>

  <section class="section-tight">
    <div class="wrap">
      <NewsletterSignup />
    </div>
  </section>
</Layout>

<style>
  .post__hero {
    position: relative;
    height: min(46vh, 420px);
    overflow: hidden;
  }
  .post__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post__hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--ink) 0%, rgba(23, 15, 43, 0) 60%);
  }

  .post__inner { max-width: 42rem; margin: 0 auto; }
  .post__date { color: var(--lavender); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.5rem; }
  .post__content :global(h2) { margin-top: 2rem; }
  .post__content :global(p) { color: var(--cream); }
  .post__content :global(a) { color: var(--gold); }
</style>
