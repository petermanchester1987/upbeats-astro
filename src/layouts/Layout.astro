---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import Analytics from '../components/Analytics.astro';
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Set to "article" on blog posts for the correct og:type + article:published_time. */
  type?: 'website' | 'article';
  publishedTime?: Date;
  /** Extra JSON-LD objects specific to this page (BlogPosting, Service, etc). */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'The Upbeats Duo — an energetic and established live party duo available for weddings, corporate parties, cruises and more.',
  image = '/open-graph/home.png',
  type = 'website',
  publishedTime,
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const SITE_NAME = 'The Upbeats Duo';

// Sitewide Organization/MusicGroup schema — helps Google understand what
// the business is, surfaces the social profiles as "sameAs", and is a
// building block for a Knowledge Panel. Emitted on every page.
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: SITE_NAME,
  url: 'https://www.theupbeatsduo.com',
  logo: new URL('/favicon.ico', Astro.site).toString(),
  image: new URL('/open-graph/home.png', Astro.site).toString(),
  email: 'theupbeatsmusicduo@gmail.com',
  genre: ['Pop', 'Funk', 'Rock', 'Soul'],
  sameAs: [
    'https://www.instagram.com/theupbeatsduo/',
    'https://soundcloud.com/user-996705933',
    'https://www.youtube.com/watch?v=pf4O9eDGHm4',
  ],
};

const schemaList = [
  orgSchema,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <link rel="icon" type="image/ico" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />

    <Font cssVariable="--font-anton" preload />
    <Font cssVariable="--font-work-sans" preload />
    <Font cssVariable="--font-caveat" preload />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_GB" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <meta name="generator" content={Astro.generator} />

    <JsonLd data={schemaList} />
  </head>
  <body>
    <a href="#main" class="visually-hidden">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>
