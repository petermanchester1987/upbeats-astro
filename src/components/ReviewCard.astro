---
interface Props {
  name: string;
  occasion: string;
  score: string;
  quote: string;
}
const { name, occasion, score, quote } = Astro.props;
---

<figure class="review card">
  <span class="review__score">{score}</span>
  <blockquote>{quote}</blockquote>
  <figcaption>
    <strong>{name}</strong>
    <span>{occasion}</span>
  </figcaption>
</figure>

<style>
  .review { margin: 0; display: flex; flex-direction: column; gap: 1rem; }
  .review__score { font-family: var(--font-script); color: var(--gold); font-size: 1.6rem; }
  .review blockquote { margin: 0; font-size: 1rem; color: var(--cream); }
  .review figcaption { display: flex; flex-direction: column; font-size: 0.85rem; color: var(--lavender); border-top: 1px solid var(--line); padding-top: 0.75rem; }
  .review figcaption strong { color: var(--cream); }
</style>
