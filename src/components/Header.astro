---
const nav = [
  { href: '/', label: 'Home' },
  { href: '/products/', label: 'Bookings' },
  { href: '/blogs/', label: 'Blog' },
  { href: '/repertoire/', label: 'Repertoire' },
  { href: 'https://store.theupbeatsduo.com', label: 'Store', external: true },
  { href: '/contact/', label: 'Contact' },
];

// Shown as a dropdown under "Bookings" on desktop. On mobile the off-canvas
// menu just links straight to /products/, which already lists every type
// as its own card — a second-level accordion there would be one tap too many.
const bookingLinks = [
  { href: '/products/weddings', label: 'Weddings' },
  { href: '/products/corporate-hire', label: 'Corporate Hire' },
  { href: '/products/cruises', label: 'Cruises' },
  { href: '/products/parties', label: 'Parties' },
  { href: '/products/christmas-party-band', label: 'Christmas Party Band' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="logo">The Upbeats <span>Duo</span></a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </label>
    <label for="nav-toggle" class="nav-scrim" aria-hidden="true"></label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {nav.map((item) =>
          item.label === 'Bookings' ? (
            <li class="has-dropdown">
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                aria-haspopup="true"
              >
                {item.label}
              </a>
              <ul class="dropdown">
                {bookingLinks.map((b) => (
                  <li><a href={b.href} aria-current={path === b.href ? 'page' : undefined}>{b.label}</a></li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
                aria-current={!item.external && path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
      <a href="/contact/" class="btn btn-solid nav-cta">Book Us Now</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid var(--line);
  }
  /* backdrop-filter lives on a pseudo-element, not .site-header itself, because
     filter/backdrop-filter on an element creates a new containing block for
     position:fixed descendants — that broke the off-canvas mobile nav's
     top:0/bottom:0 sizing when it lived directly on the header. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(23, 15, 43, 0.9);
    backdrop-filter: blur(8px);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.5rem; }
  .logo { font-family: var(--font-display); text-transform: uppercase; font-size: 1.4rem; letter-spacing: 0.02em; text-decoration: none; color: var(--cream); }
  .logo span { color: var(--gold); }
  .nav-toggle { display: none; }
  .nav-burger { display: none; }
  .site-nav { display: flex; align-items: center; gap: 2rem; }
  .site-nav ul { list-style: none; display: flex; gap: 1.75rem; margin: 0; padding: 0; }
  .site-nav a:not(.btn) { text-decoration: none; font-weight: 600; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.03em; color: var(--lavender); }
  .site-nav a:not(.btn):hover,
  .site-nav a:not(.btn)[aria-current='page'] { color: var(--gold); }
  .nav-cta { padding: 0.6em 1.3em; font-size: 0.9rem; }
  .nav-cta:hover { color: var(--ink); }

  /* Bookings dropdown — desktop only (see mobile override below) */
  .has-dropdown { position: relative; }
  .has-dropdown .dropdown {
    list-style: none;
    margin: 0;
    padding: 0.5rem;
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translate(-50%, -6px);
    min-width: 210px;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.35);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s ease;
  }
  .has-dropdown:hover .dropdown,
  .has-dropdown:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .dropdown a {
    display: block;
    padding: 0.55em 0.75em;
    border-radius: 6px;
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .dropdown a:hover,
  .dropdown a:focus-visible { background: var(--panel-light); color: var(--gold); }

  @media (max-width: 860px) {
    .nav-burger { display: flex; flex-direction: column; justify-content: center; gap: 5px; width: 34px; height: 34px; cursor: pointer; z-index: 60; }
    .nav-burger span { display: block; height: 2px; background: var(--cream); border-radius: 2px; transition: transform 0.2s ease, opacity 0.2s ease; }
    .nav-scrim {
      position: fixed;
      inset: 0;
      background: rgba(6, 4, 12, 0.88);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.25s ease, visibility 0.25s ease;
      z-index: 55;
    }
    .nav-toggle:checked ~ .nav-scrim {
      opacity: 1;
      visibility: visible;
    }
    .site-nav {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(320px, 85vw);
      flex-direction: column; align-items: flex-start; justify-content: flex-start;
      background: var(--ink); opacity: 1;
      padding: 6rem 2rem 2rem;
      overflow-y: auto;
      box-shadow: -16px 0 40px rgba(0, 0, 0, 0.45);
      transform: translateX(100%);
      visibility: hidden;
      transition: transform 0.25s ease, visibility 0.25s ease;
      z-index: 56;
    }
    .site-nav ul { flex-direction: column; gap: 1.5rem; }
    .site-nav a { font-size: 1.2rem; }
    .nav-toggle:checked ~ .site-nav {
      transform: translateX(0);
      visibility: visible;
    }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* No room for a flyout submenu in the off-canvas panel — "Bookings"
       just links to /products/, which lists every type as its own card. */
    .has-dropdown .dropdown { display: none; }
  }
</style>
