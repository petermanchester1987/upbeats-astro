---
// Facade-pattern embed: renders a lazy-loaded thumbnail + play button and
// only swaps in the real YouTube iframe (and all the JS/cookies that come
// with it — normally several hundred KB before a single frame plays) once
// someone actually clicks. That's the single biggest lever for page speed
// on a site "peppered" with videos, since an untouched embed costs almost
// nothing. youtube-nocookie.com is used for the real embed to avoid
// setting tracking cookies until that point.
import JsonLd from './JsonLd.astro';

interface Props {
  /** The YouTube video ID, e.g. "dQw4w9WgXcQ" (from youtube.com/watch?v=<id>). */
  id: string;
  /** Required for accessibility (the play button's label) and for the VideoObject schema's name. */
  title: string;
  /** Optional — adds a schema.org VideoObject for this video so it's eligible for video rich results. */
  description?: string;
  /**
   * Full ISO 8601 datetime WITH a timezone offset, e.g. "2024-06-01T14:30:00+01:00".
   * Normally leave this unset — it's fetched automatically from the video's
   * own YouTube page at build time (see fetchUploadDate below) and
   * converted to London time. Only pass this explicitly to override that
   * (e.g. if the auto-fetch ever breaks for a specific video, or you know
   * a more accurate value than YouTube's own metadata).
   */
  uploadDate?: string;
  /** Start playback at N seconds. */
  start?: number;
  class?: string;
}

const { id, title, description, uploadDate: explicitUploadDate, start, class: className } = Astro.props;

// Module-level (not per-request) cache, so a video reused across several
// pages — as these all are — is only fetched once per build/dev-server
// process rather than once per usage.
const uploadDateCache = new Map<string, string | undefined>();

// Converts a YouTube-supplied timestamp (arbitrary offset — typically
// Pacific, since that's where YouTube's servers are) to its correct
// London-local equivalent, choosing GMT or BST automatically for that
// specific date via the real IANA tz database rather than a hardcoded
// offset.
function toLondonISOString(isoDate: string): string {
  const date = new Date(isoDate);
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Europe/London',
    year: 'numeric', month: '2-digit', day: '2-digit',
    hour: '2-digit', minute: '2-digit', second: '2-digit',
    hourCycle: 'h23',
    timeZoneName: 'shortOffset',
  }).formatToParts(date);
  const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
  const offsetHours = Number(get('timeZoneName').match(/GMT([+-]\d+)?/)?.[1] ?? 0);
  const offset = offsetHours === 0 ? '+00:00' : `${offsetHours > 0 ? '+' : '-'}${String(Math.abs(offsetHours)).padStart(2, '0')}:00`;
  return `${get('year')}-${get('month')}-${get('day')}T${get('hour')}:${get('minute')}:${get('second')}${offset}`;
}

// Scrapes the real upload date from the video's own YouTube watch page —
// there's no key-free official API for this, so this is inherently a bit
// fragile (YouTube could change that page's structure), which is why every
// failure mode below falls back to just omitting uploadDate from the
// schema (exactly today's behaviour when it isn't set) rather than ever
// failing the build.
async function fetchUploadDate(videoId: string): Promise<string | undefined> {
  if (uploadDateCache.has(videoId)) return uploadDateCache.get(videoId);
  let result: string | undefined;
  try {
    const res = await fetch(`https://www.youtube.com/watch?v=${videoId}`, { signal: AbortSignal.timeout(5000) });
    if (!res.ok) throw new Error(`YouTube returned ${res.status}`);
    const html = await res.text();
    const raw = html.match(/"uploadDate":"([^"]+)"/)?.[1];
    if (!raw) throw new Error('uploadDate not found in page');
    result = toLondonISOString(raw);
  } catch (err) {
    console.warn(`[YouTube.astro] Couldn't auto-fetch uploadDate for video "${videoId}" — omitting it from this video's schema. (${err instanceof Error ? err.message : err})`);
  }
  uploadDateCache.set(videoId, result);
  return result;
}

const uploadDate = explicitUploadDate ?? (await fetchUploadDate(id));

const thumbnail = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
const embedSrc = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1${start ? `&start=${start}` : ''}`;
const watchUrl = `https://www.youtube.com/watch?v=${id}`;

const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description: description ?? title,
  thumbnailUrl: thumbnail,
  uploadDate,
  embedUrl: `https://www.youtube-nocookie.com/embed/${id}`,
};
---

<youtube-embed data-id={id} data-src={embedSrc} class={`yt ${className ?? ''}`}>
  <button type="button" class="yt__facade" aria-label={`Play video: ${title}`}>
    <img class="yt__thumb" src={thumbnail} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="yt__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7c-.8-2.9-2.5-5.2-4.9-6C57 .2 34 .2 34 .2s-23 0-27.6 1.5c-2.4.8-4.1 3.1-4.9 6C.2 12.3.2 24 .2 24s0 11.7 1.3 16.3c.8 2.9 2.5 5.1 4.9 5.9C11 47.8 34 47.8 34 47.8s23 0 27.6-1.6c2.4-.8 4.1-3 4.9-5.9C67.8 35.7 67.8 24 67.8 24s0-11.7-1.3-16.3z" fill="var(--ink)" opacity="0.85"/><path d="M27 34.5V13.5L45 24 27 34.5z" fill="var(--gold)"/></svg>
    </span>
  </button>
  <noscript>
    <a href={watchUrl} target="_blank" rel="noopener noreferrer">
      <img class="yt__thumb" src={thumbnail} alt={`Watch "${title}" on YouTube`} loading="lazy" width="480" height="360" />
    </a>
  </noscript>
</youtube-embed>

<JsonLd data={videoSchema} />

<style>
  .yt {
    display: block;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--panel);
  }
  .yt__facade {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    cursor: pointer;
    background: none;
  }
  .yt__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .yt__play {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 68px;
    transition: transform 0.15s ease;
  }
  .yt__facade:hover .yt__play,
  .yt__facade:focus-visible .yt__play { transform: translate(-50%, -50%) scale(1.08); }
  .yt__facade:focus-visible { outline: 3px solid var(--gold); outline-offset: -3px; }
  /* :global() because this iframe is created client-side after first paint
     (see the play() method below) — it never receives the data-astro-cid
     attribute Astro uses to scope this component's styles, so a scoped
     ".yt iframe" rule would silently never match it. */
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>

<script>
  class YouTubeEmbed extends HTMLElement {
    static warmed = false;

    // Opens the connection to youtube-nocookie.com just ahead of the click
    // (on hover/touchstart) rather than on page load, so pages with several
    // embeds don't spend early connections on videos nobody plays.
    static warmConnection() {
      if (YouTubeEmbed.warmed) return;
      YouTubeEmbed.warmed = true;
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = 'https://www.youtube-nocookie.com';
      document.head.appendChild(link);
    }

    connectedCallback() {
      const facade = this.querySelector('.yt__facade');
      facade?.addEventListener('mouseenter', YouTubeEmbed.warmConnection, { once: true });
      facade?.addEventListener('touchstart', YouTubeEmbed.warmConnection, { once: true, passive: true });
      facade?.addEventListener('click', () => this.play(), { once: true });
    }

    play() {
      const iframe = document.createElement('iframe');
      iframe.src = this.dataset.src ?? '';
      iframe.title = this.querySelector('.yt__facade')?.getAttribute('aria-label') ?? 'YouTube video player';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      this.replaceChildren(iframe);
      iframe.focus();
    }
  }
  customElements.define('youtube-embed', YouTubeEmbed);
</script>
